# Docker Compose defaults to local-only access. Initialize the admin before exposing it.
MIYOHUB_BIND_ADDR=127.0.0.1
MIYOHUB_HTTP_PORT=5890
# HTTPS reverse-proxy deployments: e.g. https://miyohub.example.com
MIYOHUB_PUBLIC_ORIGIN=
MIYOHUB_SECURE_COOKIE=false
# Only for a trusted deployment using a private-network OneBot/SMTP/Webhook relay.
# Enables private and loopback destinations for all users' push channels.
MIYOHUB_PUSH_ALLOW_PRIVATE=false
